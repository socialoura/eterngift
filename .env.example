# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxx

# Database (Neon / Vercel Postgres)
# POSTGRES_URL is read automatically by @vercel/postgres.
# POSTGRES_URL_NO_SSL is required by prisma.config.ts (prisma generate / db push),
# including during `npm install` (postinstall runs `prisma generate`).
POSTGRES_URL=postgresql://...
POSTGRES_URL_NO_SSL=postgresql://...
POSTGRES_USER=...
POSTGRES_HOST=...
POSTGRES_DATABASE=...
PGHOST_UNPOOLED=...

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="EternGift <orders@eterngift.com>"

# Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_CHAT_ID=xxx

# Admin (login fallback — a password changed via the dashboard is stored hashed in DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# JWT Secret (REQUIRED — signs admin auth tokens)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key

# Currency Exchange (exchangerate-api.com — optional, hardcoded fallback rates otherwise)
NEXT_PUBLIC_EXCHANGE_RATE_API_KEY=xxx
NEXT_PUBLIC_BASE_CURRENCY=USD

# Site Config
NEXT_PUBLIC_SITE_URL=https://eterngift.com

# Meta Pixel (optional — a default pixel ID is hardcoded in src/app/layout.tsx)
NEXT_PUBLIC_META_PIXEL_ID=xxx
